# Optional compose.cloudflare.yaml only. Application settings remain in SQL.
# Use your existing remotely managed Tunnel; protect its hostname with Access.
TUNNEL_TOKEN=

# Optional compose.local.yaml only; these configure relays, not SQL settings.
# The host binding remains 127.0.0.1. Match TARGET_PORT to the saved management port.
FROSTAGENT_PANEL_PORT=8088
FROSTAGENT_PANEL_TARGET_PORT=8080
