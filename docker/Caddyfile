{
	admin off
	auto_https disable_redirects
	default_sni 127.0.0.1
}

https://localhost:8080, https://127.0.0.1:8080 {
	tls internal
	basic_auth {
		{$FROSTAGENT_ADMIN_USER} {$FROSTAGENT_ADMIN_PASSWORD_HASH}
	}
	reverse_proxy 127.0.0.1:8081 {
		# Basic authentication belongs to the proxy, not FrostAgent's token APIs.
		header_up -Authorization
		flush_interval -1
	}
}
