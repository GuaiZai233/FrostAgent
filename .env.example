# 上游 API 端点 URL，支持 OpenAI 兼容服务
UPSTREAM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1

# 上游 API 认证密钥
UPSTREAM_API_KEY=sk-your-api-key-here
CODER_API_KEY=sk-your-api-key-here

# 中间件监听的地址和端口
LISTEN_ADDR=:8080
WS_LISTEN_ADDR=:1234

# 系统提示词
SYSTEM_PROMPT=你是一个乐于助人的助手。

# 模型名称
MODEL_NAME=

# 单个用户的后台记忆反思超时（Go duration，例如 10m、30m）
MEMORY_REFLECTION_TIMEOUT=10m

# 视觉模型名称（留空则采用默认模型）
VISUAL_MODEL_NAME=

# 多上下文历史裁剪：最多保留的消息数（包含 system）
MAX_CONTEXT_MESSAGES=20

# 多上下文历史裁剪：近似字符上限
MAX_CONTEXT_CHARS=24000

# 允许的Origin
WS_ALLOWED_ORIGINS=

# ======设置项

# 是否开启群聊回复前艾特
ENABLE_AT_IN_GROUP_MSG=true

# 群聊被@或名称/别名提及时触发对话回复（false 则群聊消息不回复）
GROUP_REPLY_ON_MENTION=true

# 机器人主名称与文本唤醒别名（别名使用英文逗号分隔）
BOT_NAME=霜降狐
BOT_ALIASES=霜降,FrostAgent

# 群聊回复时是否引用原消息
ENABLE_REPLY_IN_GROUP_MSG=false

# 群聊 running compact：累计多少条原消息后压缩
GROUP_COMPACT_BUFFER_SIZE=20

# 同群 running compact 的最小触发间隔（Go duration）
GROUP_COMPACT_MIN_INTERVAL=30s

# 自动记忆提取：每个会话累计 3～5 轮后批量提取
MEMORY_EXTRACT_BATCH_MIN=3
MEMORY_EXTRACT_BATCH_MAX=5

# ======计费系统设置
# 是否启用 Alcyone 雪花计费（true/1 开启）
BILLING_ENABLED=false

# Alcyone 计费服务地址
ALCYONE_BASE_URL=http://127.0.0.1:8081

# Alcyone 服务间通信 Token（可选）
ALCYONE_SERVICE_TOKEN=

# 计费请求超时时间（Go duration，默认 5s）
ALCYONE_TIMEOUT=5s

# 预扣款最大预留输出 Token（默认 2048）
BILLING_MAX_OUTPUT_TOKENS=2048

# 预扣款输入 Token 安全倍率（默认 1.2）
BILLING_SAFETY_MULTIPLIER=1.2

# 自定义模型价格覆盖（单位：厘/100万Token，1雪花=100厘，可选）
# BILLING_PROMPT_PRICE_PER_MILLION=1000
# BILLING_COMPLETION_PRICE_PER_MILLION=2000
