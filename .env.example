# FrostAgent Control Plane
LISTEN_ADDR=127.0.0.1:8080
WS_LISTEN_ADDR=127.0.0.1:1234
# Explicit non-loopback HTTP origins allowed by the control plane.
HTTP_ALLOWED_ORIGINS=
WS_ALLOWED_ORIGINS=

# Shared Alcyone upstream. Instance billing policies live in each instance .env.
ALCYONE_BASE_URL=http://127.0.0.1:8081
ALCYONE_SERVICE_TOKEN=
ALCYONE_TIMEOUT=5s

# Instance settings (SYSTEM_PROMPT, BOT_NAME, AGENT_MAX_ITERATIONS, etc.) are managed per instance in instances/<id>/.env
# AGENT_MAX_ITERATIONS: 智能体单次处理允许的最大迭代轮数，各实例独立配置，默认 35

# ====== Sandbox Runtime ======
# 是否启用隔离命令执行
SANDBOX_ENABLED=false

# 隔离命令执行沙箱网关地址 (亦可配置 FA_SANDBOX_ENDPOINT)
# - FrostAgent execute_command 原生支持 FA-Sandbox (/api/v1/shell/exec)，并自动兼容 upstream Foxerine/code-interpreter (/api/v1/execute)。
# - 注：ActionsCat 编译构建与运行需要具备 Go 工具链 profiles 的 FA-Sandbox (GuaiZai233/code-interpreter)。
SANDBOX_BASE_URL=http://127.0.0.1:3874
FA_SANDBOX_ENDPOINT=http://127.0.0.1:3874

# Gateway X-Auth-Token (亦可配置 FA_SANDBOX_AUTH_TOKEN)
SANDBOX_AUTH_TOKEN=
FA_SANDBOX_AUTH_TOKEN=

# Sandbox session namespace。
# 多 FrostAgent 实例共享同一个 Gateway 时应保证不同。
SANDBOX_SESSION_NAMESPACE=frostagent

# ====== ActionsCat Automation Platform ======
ACTIONSCAT_ENDPOINT=
ACTIONSCAT_MANAGEMENT_TOKEN=
ACTIONSCAT_DISPATCH_TOKEN=

# ====== MCP Control Plane ======
MCP_CONTROL_TOKEN=
ADMIN_TOKEN=
ALLOW_REMOTE_MCP_MANAGEMENT=false
MCP_ENFORCE_LOCAL_TOKEN=false