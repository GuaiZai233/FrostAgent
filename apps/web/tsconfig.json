{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "module": "preserve",
    "paths": {
      "@spartan-ng/helm/sidebar": ["./src/app/ui/sidebar/src/index.ts"],
      "@spartan-ng/helm/utils": ["./src/app/ui/utils/src/index.ts"],
      "@spartan-ng/helm/button": ["./src/app/ui/button/src/index.ts"],
      "@spartan-ng/helm/input": ["./src/app/ui/input/src/index.ts"],
      "@spartan-ng/helm/separator": ["./src/app/ui/separator/src/index.ts"],
      "@spartan-ng/helm/sheet": ["./src/app/ui/sheet/src/index.ts"],
      "@spartan-ng/helm/skeleton": ["./src/app/ui/skeleton/src/index.ts"],
      "@spartan-ng/helm/tooltip": ["./src/app/ui/tooltip/src/index.ts"],
      "@spartan-ng/helm/dropdown-menu": [
        "./src/app/ui/dropdown-menu/src/index.ts"
      ],
      "@spartan-ng/helm/alert-dialog": [
        "./src/app/ui/alert-dialog/src/index.ts"
      ],
      "@spartan-ng/helm/dialog": ["./src/app/ui/dialog/src/index.ts"],
      "@spartan-ng/helm/sonner": ["./src/app/ui/sonner/src/index.ts"],
      "@spartan-ng/helm/spinner": ["./src/app/ui/spinner/src/index.ts"],
      "@spartan-ng/helm/field": ["./src/app/ui/field/src/index.ts"],
      "@spartan-ng/helm/label": ["./src/app/ui/label/src/index.ts"],
      "@spartan-ng/helm/input-group": ["./src/app/ui/input-group/src/index.ts"],
      "@spartan-ng/helm/textarea": ["./src/app/ui/textarea/src/index.ts"],
      "@spartan-ng/helm/checkbox": ["./src/app/ui/checkbox/src/index.ts"],
      "@spartan-ng/helm/slider": ["./src/app/ui/slider/src/index.ts"],
      "@spartan-ng/helm/toggle-group": [
        "./src/app/ui/toggle-group/src/index.ts"
      ],
      "@spartan-ng/helm/toggle": ["./src/app/ui/toggle/src/index.ts"],
      "@spartan-ng/helm/card": ["./src/app/ui/card/src/index.ts"],
      "@spartan-ng/helm/badge": ["./src/app/ui/badge/src/index.ts"],
      "@spartan-ng/helm/table": ["./src/app/ui/table/src/index.ts"],
      "@spartan-ng/helm/pagination": ["./src/app/ui/pagination/src/index.ts"],
      "@spartan-ng/helm/select": ["./src/app/ui/select/src/index.ts"],
      "@spartan-ng/helm/tabs": ["./src/app/ui/tabs/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
